# Example .env file for Claude-Flow
# Copy this to .env and fill in your actual values

# Environment
CLAUDE_FLOW_ENVIRONMENT=development
CLAUDE_FLOW_DEBUG=true

# Claude AI API Key (Required)
CLAUDE_API_KEY=sk-your-claude-api-key-here

# GitHub Integration (Optional)
GITHUB_TOKEN=ghp_your-github-token-here

# Database (Optional - defaults to SQLite)
# CLAUDE_FLOW_DATABASE__BACKEND=postgresql
# CLAUDE_FLOW_DATABASE__HOST=localhost
# CLAUDE_FLOW_DATABASE__PORT=5432
# CLAUDE_FLOW_DATABASE__DATABASE=claude_flow
# CLAUDE_FLOW_DATABASE__USERNAME=postgres
# CLAUDE_FLOW_DATABASE__PASSWORD=your-password

# Redis (Optional)
# CLAUDE_FLOW_REDIS__HOST=localhost
# CLAUDE_FLOW_REDIS__PORT=6379
# CLAUDE_FLOW_REDIS__PASSWORD=your-redis-password

# Security
# CLAUDE_FLOW_SECURITY__SECRET_KEY=your-secret-key-here

# Logging
CLAUDE_FLOW_LOGGING__LEVEL=DEBUG

# Performance
CLAUDE_FLOW_PERFORMANCE__MAX_WORKERS=4

# Feature Flags
CLAUDE_FLOW_EXPERIMENTAL_FEATURES=true
CLAUDE_FLOW_TELEMETRY_ENABLED=false